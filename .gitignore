# tauri rust
target/
src-tauri/target/
# Tauri generates the mobile projects here; they stay ignored except the iOS
# project, which carries hand-tuned pieces Tauri's template does not emit:
# ENABLE_USER_SCRIPT_SANDBOXING=NO and UIApplicationSceneManifest (project.yml,
# which XcodeGen turns into the .pbxproj and Info.plist), plus the
# ExportOptions.plist scripts/ios-run-device.sh exports with. Tracking them
# means a `tauri ios init` that regenerates the directory shows up as a
# revertable diff instead of silently dropping the fixes.
src-tauri/gen/*
!src-tauri/gen/apple/
src-tauri/gen/apple/*
!src-tauri/gen/apple/project.yml
!src-tauri/gen/apple/ExportOptions.plist
!src-tauri/gen/apple/voltius_iOS/
src-tauri/gen/apple/voltius_iOS/*
!src-tauri/gen/apple/voltius_iOS/Info.plist
!src-tauri/gen/apple/voltius.xcodeproj/
src-tauri/gen/apple/voltius.xcodeproj/*
!src-tauri/gen/apple/voltius.xcodeproj/project.pbxproj

# local planning docs and Claude artifacts
.claude/*
!.claude/skills/
docs/superpowers/
.superpowers/
specs/

# on-device / emulator screenshots captured while iterating
screenshots/

# local dev scratch: the docker cargo registry cache and the WebDriver harnesses.
# Untracked but previously unignored, so a `git add -A` swept 58k files into a commit.
.cargo-home/
disco.mjs
wd.mjs
dist-plugin-types/
packages/plugin-types/index.d.ts

# This project uses pnpm; an npm lockfile would silently diverge from CI.
package-lock.json

# flatpak-builder output from a local test build of packaging/flatpak. Written
# by a container running as root, so it is also awkward to clean up by accident.
packaging/flatpak/build-dir/
packaging/flatpak/.flatpak-builder/
